<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/ecard_widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_ecard_bg"
    android:clipToOutline="true"
    android:contentDescription="@string/ecard_widget_description">

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0.16"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop"
        android:src="@drawable/ecard_card_bottom"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <FrameLayout
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="@drawable/widget_ecard_qr_badge"
                android:padding="8dp">

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_widget_ecard_qr_white"/>
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:fontFamily="sans-serif-medium"
                    android:maxLines="1"
                    android:text="@string/ecard_widget_title"
                    android:textColor="#FFFFFFFF"
                    android:textSize="16sp"/>

                <TextView
                    android:id="@+id/ecard_widget_subtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="@string/ecard_widget_subtitle"
                    android:textColor="#CCFFFFFF"
                    android:textSize="11sp"/>
            </LinearLayout>

            <ImageView
                android:id="@+id/ecard_widget_mask_btn"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:background="@drawable/widget_ecard_qr_badge"
                android:contentDescription="@string/widget_ecard_hide_balance"
                android:padding="8dp"
                android:src="@drawable/ic_widget_eye"/>
        </LinearLayout>

        <TextView
            android:layout_width="1dp"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:importantForAccessibility="no"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="bottom"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/ecard_widget_balance"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:fontFamily="monospace"
                android:maxLines="1"
                android:text="••••"
                android:textColor="#FFFFFFFF"
                android:textSize="22sp"
                android:textStyle="bold"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/widget_ecard_card_brand"
                android:textColor="#BFFFFFFF"
                android:textSize="11sp"/>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
