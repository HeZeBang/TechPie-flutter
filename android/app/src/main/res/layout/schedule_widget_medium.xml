<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/schedule_widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_surface_bg"
    android:clipToOutline="true"
    android:orientation="vertical"
    android:padding="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_widget_schedule"/>

        <TextView
            android:id="@+id/schedule_header_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:maxLines="1"
            android:text="@string/widget_schedule_today"
            android:textColor="@color/widget_brand_ink"
            android:textSize="13sp"/>

        <TextView
            android:id="@+id/schedule_week_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:background="@drawable/widget_pill_brand"
            android:maxLines="1"
            android:paddingStart="7dp"
            android:paddingTop="2dp"
            android:paddingEnd="7dp"
            android:paddingBottom="2dp"
            android:textColor="@color/widget_brand_ink"
            android:textSize="10sp"
            android:textStyle="bold"
            android:visibility="gone"/>

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:importantForAccessibility="no"/>

        <TextView
            android:id="@+id/schedule_day_toggle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/widget_pill_muted"
            android:maxLines="1"
            android:paddingStart="9dp"
            android:paddingTop="3dp"
            android:paddingEnd="9dp"
            android:paddingBottom="3dp"
            android:text="@string/widget_schedule_switch_tomorrow"
            android:textColor="@color/widget_text_secondary"
            android:textSize="11sp"
            android:textStyle="bold"/>
    </LinearLayout>

    <TextView
        android:id="@+id/schedule_empty_state"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:text="@string/widget_schedule_no_more_classes"
        android:textColor="@color/widget_text_secondary"
        android:textSize="13sp"
        android:visibility="gone"/>

    <LinearLayout
        android:id="@+id/schedule_row_1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/schedule_row_1_accent"
            android:layout_width="3dp"
            android:layout_height="28dp"
            android:background="@color/widget_brand_ink"
            android:importantForAccessibility="no"/>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/schedule_row_1_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1"
                android:textColor="@color/widget_text_primary"
                android:textSize="13sp"/>

            <TextView
                android:id="@+id/schedule_row_1_meta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/widget_text_secondary"
                android:textSize="11sp"/>
        </LinearLayout>

        <TextView
            android:id="@+id/schedule_row_1_live"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="6dp"
            android:background="@drawable/widget_pill_brand"
            android:maxLines="1"
            android:paddingStart="6dp"
            android:paddingTop="1dp"
            android:paddingEnd="6dp"
            android:paddingBottom="1dp"
            android:text="@string/widget_schedule_in_progress"
            android:textColor="@color/widget_brand_ink"
            android:textSize="10sp"
            android:visibility="gone"/>

        <TextView
            android:id="@+id/schedule_row_1_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:maxLines="1"
            android:textColor="@color/widget_text_secondary"
            android:textSize="11sp"/>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/schedule_row_2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="7dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/schedule_row_2_accent"
            android:layout_width="3dp"
            android:layout_height="28dp"
            android:background="@color/widget_brand_ink"
            android:importantForAccessibility="no"/>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/schedule_row_2_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1"
                android:textColor="@color/widget_text_primary"
                android:textSize="13sp"/>

            <TextView
                android:id="@+id/schedule_row_2_meta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/widget_text_secondary"
                android:textSize="11sp"/>
        </LinearLayout>

        <TextView
            android:id="@+id/schedule_row_2_live"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="6dp"
            android:background="@drawable/widget_pill_brand"
            android:maxLines="1"
            android:paddingStart="6dp"
            android:paddingTop="1dp"
            android:paddingEnd="6dp"
            android:paddingBottom="1dp"
            android:text="@string/widget_schedule_in_progress"
            android:textColor="@color/widget_brand_ink"
            android:textSize="10sp"
            android:visibility="gone"/>

        <TextView
            android:id="@+id/schedule_row_2_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:maxLines="1"
            android:textColor="@color/widget_text_secondary"
            android:textSize="11sp"/>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/schedule_row_3"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="7dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/schedule_row_3_accent"
            android:layout_width="3dp"
            android:layout_height="28dp"
            android:background="@color/widget_brand_ink"
            android:importantForAccessibility="no"/>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/schedule_row_3_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1"
                android:textColor="@color/widget_text_primary"
                android:textSize="13sp"/>

            <TextView
                android:id="@+id/schedule_row_3_meta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/widget_text_secondary"
                android:textSize="11sp"/>
        </LinearLayout>

        <TextView
            android:id="@+id/schedule_row_3_live"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="6dp"
            android:background="@drawable/widget_pill_brand"
            android:maxLines="1"
            android:paddingStart="6dp"
            android:paddingTop="1dp"
            android:paddingEnd="6dp"
            android:paddingBottom="1dp"
            android:text="@string/widget_schedule_in_progress"
            android:textColor="@color/widget_brand_ink"
            android:textSize="10sp"
            android:visibility="gone"/>

        <TextView
            android:id="@+id/schedule_row_3_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:maxLines="1"
            android:textColor="@color/widget_text_secondary"
            android:textSize="11sp"/>
    </LinearLayout>

    <TextView
        android:id="@+id/schedule_overflow_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="end"
        android:textColor="@color/widget_text_muted"
        android:textSize="10sp"
        android:visibility="gone"/>
</LinearLayout>
