{
  "app": {
    "bundleName": "com.geekpie.techpie.watch",
    "vendor": "geekpie",
    "version": { "code": 4, "name": "0.3.0" }
  },
  "deviceConfig": {},
  "module": {
    "deviceType": ["liteWearable"],
    "reqPermissions": [{
      "name": "ohos.permission.VIBRATE",
      "reason": "用于待办截止前的振动提醒",
      "usedScene": { "ability": ["MainAbility"], "when": "inuse" }
    }],
    "distro": {
      "deliveryWithInstall": true,
      "moduleName": "entry",
      "moduleType": "entry"
    },
    "abilities": [{
      "name": ".MainAbility",
      "srcLanguage": "js",
      "srcPath": "MainAbility",
      "icon": "$media:icon",
      "description": "$string:app_description",
      "label": "$string:app_name",
      "type": "page"
    }],
    "js": [{ "name": ".MainAbility", "pages": ["pages/index/index"] }]
  }
}
