{
  "app": {
    "bundleName": "com.geekpie.techpie.watch",
    "vendor": "geekpie",
    "version": { "code": 2, "name": "0.2.0" }
  },
  "deviceConfig": {},
  "module": {
    "deviceType": ["liteWearable"],
    "reqPermissions": [{ "name": "ohos.permission.VIBRATE" }],
    "distro": {
      "deliveryWithInstall": true,
      "moduleName": "entry",
      "moduleType": "entry"
    },
    "abilities": [{
      "name": ".MainAbility",
      "srcLanguage": "js",
      "srcPath": "MainAbility",
      "icon": "$media:icon",
      "description": "$string:app_description",
      "label": "$string:app_name",
      "type": "page"
    }],
    "js": [{ "name": ".MainAbility", "pages": ["pages/index/index"] }]
  }
}
