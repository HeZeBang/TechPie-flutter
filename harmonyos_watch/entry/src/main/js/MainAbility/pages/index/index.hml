<div class="screen">
  <swiper class="deck" vertical="true" loop="false" index="{{ pageIndex }}" ref="deck" onchange="onPageChange" onswipe="onSwipe" if="{{ view === 'deck' }}">
    <div class="panel">
      <div class="panel-header">
        <text class="page-title" onclick="showAccount">校园码 ›</text>
        <text class="page-status">{{ crownError || status }}</text>
      </div>
      <div class="code-area" show="{{ codeVisible }}">
        <canvas class="qr" id="campusQr" ref="qr"></canvas>
      </div>
      <div class="code-area" show="{{ !codeVisible }}">
        <div class="code-placeholder" onclick="refreshCode">
          <text class="placeholder-title">校园码</text>
          <text class="placeholder-detail">{{ codeMessage }}</text>
        </div>
      </div>
      <text class="code-caption" onclick="refreshCode">{{ codeMessage }}</text>
      <div class="code-bottom"></div>
    </div>
    <div class="panel">
      <div class="panel-header"><text class="page-title">课表</text><text class="page-status">{{ dayLabel }}</text></div>
      <text class="glance-time">{{ courseTime }}</text>
      <text class="glance-title">{{ courseName }}</text>
      <text class="glance-detail">{{ courseLocation }}</text>
      <input class="glance-action" type="button" value="今日课程 · {{ courseCount }} 节" onclick="showSchedule" />
      <div class="glance-bottom"></div>
    </div>
    <div class="panel">
      <div class="panel-header"><text class="page-title">待办</text><text class="page-status">{{ status }}</text></div>
      <text class="glance-time due-color">{{ alertTitle ? '待办提醒' : ddlDue }}</text>
      <text class="glance-title">{{ alertTitle || ddlTitle }}</text>
      <text class="glance-detail">{{ ddlCourse }}</text>
      <input class="glance-action" type="button" value="全部待办 · {{ ddlCount }} 项" onclick="showDdl" />
      <div class="glance-bottom"></div>
    </div>
  </swiper>
  <list class="details" ref="details" onswipe="onSwipe" if="{{ view !== 'deck' }}">
    <list-item class="detail-header"><div class="detail-heading">
      <text class="detail-title">{{ detailTitle }}</text>
      <text class="detail-subtitle">{{ view === 'schedule' ? dayLabel : '向右滑动返回' }}</text>
    </div></list-item>
    <list-item class="day-controls" if="{{ view === 'schedule' }}"><div class="control-pair">
      <input class="day-button" type="button" value="前一天" onclick="previousDay" if="{{ dayOffset > 0 }}" />
      <input class="day-button" type="button" value="后一天" onclick="nextDay" if="{{ dayOffset < 6 }}" />
    </div></list-item>
    <list-item class="detail-row" for="{{ view === 'schedule' || view === 'ddl' ? rows : [] }}"><div class="detail-card">
      <text class="row-caption">{{ $item.caption }}</text>
      <text class="row-title">{{ $item.title }}</text>
      <text class="row-detail">{{ $item.detail }}</text>
    </div></list-item>
    <list-item class="empty-row" if="{{ (view === 'schedule' || view === 'ddl') &amp;&amp; rows.length === 0 }}"><div class="empty-box">
      <text class="empty-text">{{ view === 'schedule' ? '当天没有课程' : '暂无待办' }}</text>
    </div></list-item>
    <list-item class="account-row" if="{{ view === 'account' }}"><div class="account-box">
      <text class="account-name">{{ name }}</text>
      <text class="account-id">{{ studentId }}</text>
      <text class="account-sync">上次同步 {{ lastSync }}</text>
      <text class="account-hint">课表与待办在离线时仍可查看</text>
    </div></list-item>
    <list-item class="sync-row"><div class="sync-box">
      <input class="sync-button" type="button" value="同步数据" onclick="synchronize" />
      <text class="sync-note">{{ error || status }}</text>
    </div></list-item>
    <list-item class="end-row"><div class="end-space"></div></list-item>
  </list>
</div>
