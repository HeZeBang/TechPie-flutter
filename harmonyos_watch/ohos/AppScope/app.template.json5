// Template for ohos/AppScope/app.json5.
//
// The real file is generated by ohos/scripts/generate-build-profile.mjs, which
// hvigorfile.ts runs on every hvigor invocation (so DevEco builds too), and is
// gitignored. The version placeholders are filled from pubspec.yaml: that file
// is the single source of truth for the app version, and `flutter build hap`
// already stamps the packed bundle from it. Rendering the same numbers here
// keeps a DevEco-only build from disagreeing with a Flutter build.
//
// Bump the version in pubspec.yaml (`version: X.Y.Z+N`), never in this template.
{
  "app": {
    "bundleName": "com.geekpie.techpie",
    "vendor": "geekpie",
    "versionCode": __APP_VERSION_CODE__,
    "versionName": "__APP_VERSION_NAME__",
    "icon": "$media:layered_image",
    "label": "$string:app_name"
  }
}
