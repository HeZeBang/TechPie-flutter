{
  "$schema": "https://www.designtokens.org/schemas/2025.10/format.json",
  "brand": {
    "techRed": {
      "$type": "color",
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.6392156862745098,
          0.043137254901960784,
          0.09803921568627451
        ],
        "hex": "#A30B19"
      }
    },
    "appIcon": {
      "$description": "Review proposal for the Apple app icon, from the faceted P at branch revision 9ac9844.",
      "canvas": {
        "width": {
          "$type": "dimension",
          "$value": {
            "value": 1024,
            "unit": "px"
          }
        },
        "height": {
          "$type": "dimension",
          "$value": {
            "value": 1024,
            "unit": "px"
          }
        },
        "$extensions": {
          "com.techpie.apple": {
            "maskOwner": "system"
          }
        }
      },
      "mark": {
        "designHeight": {
          "$type": "dimension",
          "$value": {
            "value": 672,
            "unit": "px"
          },
          "$description": "Nominal lattice height before corner rounding."
        },
        "offsetX": {
          "$type": "dimension",
          "$value": {
            "value": 20.48,
            "unit": "px"
          },
          "$description": "Positive is right, relative to canvas center. Matches the in-app badge alignment."
        },
        "offsetY": {
          "$type": "dimension",
          "$value": {
            "value": 24,
            "unit": "px"
          },
          "$description": "Positive is down, relative to canvas center. Compensates for the visual weight of the upper triangle faces."
        },
        "convexCornerInsetPerTriangleSide": {
          "$type": "number",
          "$value": 0.16,
          "$description": "Each exterior quadratic corner starts and ends this fraction of one triangle side away from the vertex."
        },
        "counterCornerInset": {
          "$type": "dimension",
          "$value": {
            "value": 0,
            "unit": "px"
          },
          "$description": "Keep the interior triangular cutout sharp."
        }
      },
      "color": {
        "default": {
          "top": {
            "$type": "color",
            "$value": {
              "colorSpace": "srgb",
              "components": [
                0.7490196078431373,
                0.07058823529411765,
                0.12549019607843137
              ],
              "hex": "#BF1220"
            }
          },
          "bottom": {
            "$type": "color",
            "$value": {
              "colorSpace": "srgb",
              "components": [
                0.5294117647058824,
                0.01568627450980392,
                0.07058823529411765
              ],
              "hex": "#870412"
            }
          }
        },
        "dark": {
          "top": {
            "$type": "color",
            "$value": {
              "colorSpace": "srgb",
              "components": [
                0.5254901960784314,
                0.08627450980392157,
                0.1411764705882353
              ],
              "hex": "#861624"
            }
          },
          "bottom": {
            "$type": "color",
            "$value": {
              "colorSpace": "srgb",
              "components": [
                0.3176470588235294,
                0.023529411764705882,
                0.050980392156862744
              ],
              "hex": "#51060D"
            }
          }
        },
        "facets": {
          "tone1": {
            "$type": "color",
            "$value": {
              "colorSpace": "srgb",
              "components": [
                1.0,
                1.0,
                1.0
              ],
              "hex": "#FFFFFF"
            }
          },
          "tone2": {
            "$type": "color",
            "$value": {
              "colorSpace": "srgb",
              "components": [
                1.0,
                0.9529411764705882,
                0.9568627450980393
              ],
              "hex": "#FFF3F4"
            }
          },
          "tone3": {
            "$type": "color",
            "$value": {
              "colorSpace": "srgb",
              "components": [
                1.0,
                0.9019607843137255,
                0.9098039215686274
              ],
              "hex": "#FFE6E8"
            }
          },
          "tone4": {
            "$type": "color",
            "$value": {
              "colorSpace": "srgb",
              "components": [
                1.0,
                0.8352941176470589,
                0.8509803921568627
              ],
              "hex": "#FFD5D9"
            }
          },
          "tone5": {
            "$type": "color",
            "$value": {
              "colorSpace": "srgb",
              "components": [
                1.0,
                0.7607843137254902,
                0.7843137254901961
              ],
              "hex": "#FFC2C8"
            }
          },
          "tone6": {
            "$type": "color",
            "$value": {
              "colorSpace": "srgb",
              "components": [
                1.0,
                0.6784313725490196,
                0.7176470588235294
              ],
              "hex": "#FFADB7"
            }
          }
        }
      },
      "background": {
        "$extensions": {
          "com.techpie.gradient": {
            "start": [
              0.5,
              0
            ],
            "end": [
              0.5,
              1
            ],
            "interpolation": "srgb"
          }
        },
        "default": {
          "$type": "gradient",
          "$value": [
            {
              "color": "{brand.appIcon.color.default.top}",
              "position": 0
            },
            {
              "color": "{brand.appIcon.color.default.bottom}",
              "position": 1
            }
          ]
        },
        "dark": {
          "$type": "gradient",
          "$value": [
            {
              "color": "{brand.appIcon.color.dark.top}",
              "position": 0
            },
            {
              "color": "{brand.appIcon.color.dark.bottom}",
              "position": 1
            }
          ]
        }
      },
      "material": {
        "$description": "Starting parameters for visual validation in Icon Composer 2.",
        "$extensions": {
          "com.techpie.iconComposer": {
            "groupMode": "combined",
            "specular": "automatic",
            "refraction": false,
            "blur": false,
            "customShadow": false,
            "translucency": false
          }
        },
        "foregroundOpacity": {
          "$type": "number",
          "$value": 1
        }
      }
    },
    "inAppBadge": {
      "cornerRadiusRatio": {
        "$type": "number",
        "$value": 0.24,
        "$description": "Existing Flutter circular-arc radius divided by badge width."
      },
      "markHeightRatio": {
        "$type": "number",
        "$value": 0.66,
        "$description": "Existing Flutter badge lattice height divided by badge height."
      },
      "markOffsetXRatio": {
        "$type": "number",
        "$value": 0.02
      }
    },
    "inAppGlyph": {
      "markHeightRatio": {
        "$type": "number",
        "$value": 0.94,
        "$description": "Existing Flutter standalone mark lattice height divided by layout height."
      },
      "darkFacets": {
        "$description": "Opaque tones, lightest first. Lowest tone has 3.03:1 contrast against TpTokens.darkSurfaceSubtle (#2C2C2E).",
        "tone1": {
          "$type": "color",
          "$value": {
            "colorSpace": "srgb",
            "components": [
              1.0,
              0.5568627450980392,
              0.592156862745098
            ],
            "hex": "#FF8E97"
          }
        },
        "tone2": {
          "$type": "color",
          "$value": {
            "colorSpace": "srgb",
            "components": [
              1.0,
              0.45098039215686275,
              0.49411764705882355
            ],
            "hex": "#FF737E"
          }
        },
        "tone3": {
          "$type": "color",
          "$value": {
            "colorSpace": "srgb",
            "components": [
              0.9764705882352941,
              0.3803921568627451,
              0.4392156862745098
            ],
            "hex": "#F96170"
          }
        },
        "tone4": {
          "$type": "color",
          "$value": {
            "colorSpace": "srgb",
            "components": [
              0.9490196078431372,
              0.2980392156862745,
              0.35294117647058826
            ],
            "hex": "#F24C5A"
          }
        },
        "tone5": {
          "$type": "color",
          "$value": {
            "colorSpace": "srgb",
            "components": [
              0.9137254901960784,
              0.26666666666666666,
              0.3215686274509804
            ],
            "hex": "#E94452"
          }
        },
        "tone6": {
          "$type": "color",
          "$value": {
            "colorSpace": "srgb",
            "components": [
              0.8431372549019608,
              0.2235294117647059,
              0.2784313725490196
            ],
            "hex": "#D73947"
          }
        }
      }
    }
  }
}
