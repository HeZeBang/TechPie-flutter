# Generated by scripts/prepare-aur.py from a published stable release.
pkgname=techpie-bin
pkgver=@VERSION@
pkgrel=@BUILD@
pkgdesc='ShanghaiTech campus services'
arch=('x86_64')
url='https://github.com/HeZeBang/TechPie-flutter'
license=('MIT')
depends=('gcc-libs' 'glibc' 'gtk3' 'webkit2gtk-4.1' 'libsecret' 'json-glib' 'libglvnd')
optdepends=('python: install optional desktop widgets'
            'gnome-shell: GNOME deadline widget'
            'qt6-declarative: KDE deadline widget')
provides=('techpie')
conflicts=('techpie')
options=('!strip' '!debug')
_tag='@TAG@'
_repo='@REPOSITORY@'
source=("https://github.com/${_repo}/releases/download/${_tag}/TechPie-${pkgver}-linux-x86-64.tar.gz"
        'techpie.desktop'
        "techpie.png::https://raw.githubusercontent.com/${_repo}/${_tag}/assets/icon/icon.png"
        "README.md::https://raw.githubusercontent.com/${_repo}/${_tag}/README.md")
sha256sums=('@BUNDLE_SHA256@'
            '@DESKTOP_SHA256@'
            '@ICON_SHA256@'
            '@README_SHA256@')

package() {
  install -d "$pkgdir/opt/techpie" "$pkgdir/usr/bin"
  cp -a "$srcdir/bundle/." "$pkgdir/opt/techpie/"
  cat > "$pkgdir/usr/bin/techpie" <<'LAUNCHER'
#!/bin/sh
export LD_LIBRARY_PATH="/opt/techpie/lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
exec /opt/techpie/techpie "$@"
LAUNCHER
  chmod 755 "$pkgdir/usr/bin/techpie"
  install -Dm644 techpie.desktop "$pkgdir/usr/share/applications/techpie.desktop"
  install -Dm644 techpie.png "$pkgdir/usr/share/icons/hicolor/512x512/apps/techpie.png"
  install -Dm644 README.md "$pkgdir/usr/share/licenses/$pkgname/README.md"
}
